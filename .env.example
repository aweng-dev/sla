# The API origin. The SPA is served on every tenant hostname while the API
# answers on one, so this is always cross-origin.
VITE_API_URL=http://localhost:8000/rest/v1

# Overrides window.location.hostname when naming the tenant to the API.
# Required on localhost, where the browser's hostname belongs to no institution.
# Leave unset in production: the real tenant hostname is the right answer.
VITE_TENANT_DOMAIN=greenfield.schoollink.test
